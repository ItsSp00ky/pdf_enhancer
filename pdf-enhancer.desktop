[Desktop Entry]
Version=1.0
Type=Application
Name=PDF Enhancer
GenericName=PDF & Image Document Scanner
Comment=Transform scanned PDFs and images into clean, deskewed, high-contrast black & white documents
Exec=pdf-enhancer %F
Icon=pdf-enhancer
Terminal=false
Categories=Office;Graphics;Scanning;Utility;
MimeType=application/pdf;image/jpeg;image/png;image/tiff;image/bmp;
StartupNotify=true
